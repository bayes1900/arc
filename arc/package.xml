<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arc</name>
  <version>0.0.1</version>
  <description>ARC core mapping, planning, VIO/LIO and visualization library</description>
  <maintainer email="arc@example.com">arc</maintainer>
  <license>NONE</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nlohmann-json3-dev</depend>
  <depend>yaml-cpp</depend>
  <depend>visualization_msgs</depend>
  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libopencv-dev</depend>
  <depend>libnlopt-cxx-dev</depend>
  <depend>tbb</depend>
  <depend>sophus</depend>
  <depend>fmt</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
